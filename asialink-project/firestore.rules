rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "renatkazakhbaev@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // каталог товаров из Telegram-канала: читать могут все, менять — только админ
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // покупатель может создать только свой заказ со статусом "waiting"
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "waiting";

      // покупатель видит только свои заказы, админ — все
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());

      // менять статус может только админ
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
